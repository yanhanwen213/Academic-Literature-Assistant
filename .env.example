# -*- coding: utf-8 -*-
# 复制为 .env 后按需修改（.env 已在 .gitignore 中，不会被提交）
#
# 重要：这里填的是「模型名」，不是网址。
# 网址（接口地址）由 LLM_PROVIDER 自动决定：Groq / DeepSeek / OpenAI 各自固定，
# 只有 LLM_PROVIDER=custom 时才需要你自己写 LLM_BASE_URL。

# ============================ 大模型 ============================
# 选择调用哪一家的接口：groq | deepseek | openai | custom
#   groq     -> 需要 GROQ_API_KEY，     模型名形如 llama3-70b-8192
#   deepseek -> 需要 DEEPSEEK_API_KEY， 模型名形如 deepseek-chat
#   openai   -> 需要 OPENAI_API_KEY，   模型名形如 gpt-4o-mini
#   custom   -> 任意 OpenAI 兼容接口，需要 LLM_API_KEY + LLM_BASE_URL
LLM_PROVIDER=deepseek

# 默认模型名（必须出现在下面的可选列表里，否则自动取列表第一项）
#DEFAULT_LLM_MODEL=llama3-70b-8192
# 可选：覆盖前端下拉框里的模型列表（逗号分隔），不填则用该 provider 的默认列表
# LLM_MODELS=llama3-70b-8192,llama3-8b-8192

# --- groq（默认） ---
#GROQ_API_KEY=your_groq_api_key

# --- deepseek：把上面的 LLM_PROVIDER 改成 deepseek，再填这些 ---
DEEPSEEK_API_KEY=sk-在这里粘贴你的_deepseek_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_LLM_MODEL=deepseek-chat
LLM_MODELS=deepseek-chat,deepseek-reasoner

# --- 自定义 OpenAI 兼容服务（本地 vLLM / Ollama 的 OpenAI 接口 / 其他中转） ---
# LLM_PROVIDER=custom
# LLM_API_KEY=any_value
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODELS=qwen2.5:7b
# DEFAULT_LLM_MODEL=qwen2.5:7b

# ============================ Embedding ============================
# 方案 A（默认，本地免费）：Ollama + nomic-embed-text（768 维，离线、不花钱）
#   1) 安装 Ollama：https://ollama.com/download
#   2) 拉取模型：ollama pull nomic-embed-text
#   3) 确认服务在跑：浏览器打开 http://127.0.0.1:11434
DEFAULT_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_HOST=http://127.0.0.1:11434

# 方案 B（OpenAI）：把上面的默认模型换成 text-embedding-3-small 并填 key
# DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_API_KEY=sk-你的_openai_key

# 说明：DeepSeek 不提供 embedding 接口，向量化只能用上面两种之一

# ==================== 向量库 / 会话存储 ====================
# 向量库是嵌入式 LanceDB，数据落在本地目录，不需要任何数据库服务
LANCEDB_DIR=data/lancedb
# 会话历史 SQLite 文件
SQLITE_PATH=data/assistant.db
ENABLE_ASSISTANT_STORAGE=true

# ==================== 账号 / 权限 / 审计 ====================
# 登录门禁开关：true=必须登录；false=以本地管理员身份直接进入（仅本机调试用）
APP_AUTH_ENABLED=true
# 平台库：账号 / 审计日志 / 用量统计（与会话库分开，可单独备份）
APP_PLATFORM_DB=data/platform.db
# 首次启动自动创建的管理员。密码留空则随机生成，只在启动日志与登录页显示一次
APP_ADMIN_USER=admin
# APP_ADMIN_PASSWORD=改成你自己的强密码
# 新用户默认每日提问配额（0 = 不限）；访客默认更低
APP_MEMBER_QUOTA=200
APP_GUEST_QUOTA=30
# 登录失败限流：连续失败 N 次后锁定 M 秒
APP_LOGIN_MAX_FAILS=5
APP_LOGIN_LOCK_SECONDS=60
# 审计日志保留天数（0 = 永久保留）
APP_AUDIT_KEEP_DAYS=180
# 后台成本估算单价（元 / 1K tokens），0 表示只显示 token 数不显示金额
APP_TOKEN_PRICE_PER_1K=0

# ==================== 多知识库（前端可命名 / 切换） ====================
# 知识库注册表（名称 → 目录），前端「＋ 新建知识库…」会写这个文件
RAG_LIBRARIES_REGISTRY=data/libraries.json
# 新建知识库的存放根目录（每个库独立向量表 / 引用图 / 抽取库）
RAG_LIBRARIES_DIR=data/libraries
# 说明：默认知识库沿用上面的 LANCEDB_DIR / RAG_GRAPH_PATH / RAG_EXTRACTION_PATH，
#      历史数据不需要迁移；只有新建的库才会落到 RAG_LIBRARIES_DIR 下。

# ============================ Agent 行为 ============================
NUM_HISTORY_MESSAGES=4
AGENT_DEBUG=false

# ==================== 文献切分 / 检索（RAG） ====================
# 每次提问检索多少个片段塞进 prompt（调大更全面，但更慢更贵）
RAG_NUM_DOCUMENTS=2
# 每个片段的字符数上限与相邻重叠
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150
# 过短的片段直接丢弃（图注残片、页码残留），0 表示不过滤
RAG_MIN_CHUNK_CHARS=40
# 同一篇文献内重复段落/片段只保留一份
RAG_DEDUPE_CHUNKS=true
# 入库文本前加一行「《论文标题》 章节名」，通常能提升命中率
RAG_CONTEXTUAL_HEADER=true
# 是否把参考文献章节也入库（默认 false，噪声大）
RAG_INCLUDE_REFERENCES=false
# arXiv 接口超时（秒）
ARXIV_TIMEOUT=30
# arXiv 被墙/出口网关拦截时，给 arXiv 请求单独配代理（只影响 arXiv）
# ARXIV_PROXY=http://127.0.0.1:7890
# 默认 https://export.arxiv.org/api/query，失败自动退回 http；也可指定镜像
# ARXIV_API_BASE=https://export.arxiv.org/api/query

# ==================== 检索增强（混合检索 / 重排 / 查询改写） ====================
# 检索模式：hybrid（BM25 + 向量 + RRF，默认）/ dense（纯向量基线）
RAG_RETRIEVAL_MODE=hybrid
# 每一路各自召回多少候选（再融合、再重排）
RAG_RECALL_PER_ROUTE=20
# RRF 平滑常数，业界常用 60
RAG_RRF_K=60

# Query 改写：off / history（多轮补全）/ multi_query（多问法展开）/ both（默认）
RAG_QUERY_REWRITE=both
# 每次额外生成几个问法（不含原问题）
RAG_REWRITE_NUM_QUERIES=2

# 重排：off / llm / cross-encoder / auto（默认：本地模型已缓存就用它，否则用 llm）
RAG_RERANK_MODE=auto
# cross-encoder 模型（中英混合文献建议 BAAI/bge-reranker-base）
RAG_RERANK_MODEL=BAAI/bge-reranker-base
# 重排后保留多少片段送进 prompt
RAG_RERANK_TOP_N=3
# 本地 rerank 模型缓存目录（首次使用需要联网下载一次）
RAG_RERANK_CACHE_DIR=data/models

# ==================== 引用溯源 / 拒答校准 / 多步工具链 ====================
# 强制模型在回答里标 [编号]，并对回答做引用校验（编号越界 / 完全未溯源会告警）
RAG_CITATION_ENABLED=true
RAG_CITATION_REQUIRED=true
# 检索置信度（相似度 × 关键词覆盖的几何平均）低于阈值就直接拒答
RAG_REFUSAL_ENABLED=true
RAG_REFUSAL_MIN_CONFIDENCE=0.30
# 多步工具链：auto 按问题类型自动启用 / on 总是启用 / off 只用单步 RAG
RAG_TOOL_MODE=auto
RAG_TOOL_MAX_STEPS=4
RAG_TOOL_FINAL_DOCUMENTS=4

# ==================== 创新点 1：引用图谱（多跳检索） ====================
# 引用图（networkx）持久化路径
RAG_GRAPH_PATH=data/citation_graph.json
# 是否启用引用图谱工具（get_references / get_citations / trace_lineage）
RAG_GRAPH_ENABLED=true
# 数据源：semantic_scholar（有真实 cited-by）/ pdf（只能拿到参考文献）
RAG_GRAPH_SOURCE=semantic_scholar
# Semantic Scholar API（免费；不填 key 时容易被限流返回 429，建议申请免费 key）
# key 申请：https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API=https://api.semanticscholar.org/graph/v1
# SEMANTIC_SCHOLAR_API_KEY=
RAG_GRAPH_HTTP_TIMEOUT=15
RAG_GRAPH_MAX_HOPS=2
# 两次 S2 请求之间的最小间隔（秒）。官方 key 额度是「1 请求/秒，全端点累计」，
# 默认有 key 时 1.1s、无 key 时 3.1s（5 分钟 100 次）；一般不用改。
# SEMANTIC_SCHOLAR_MIN_INTERVAL=1.1
# 遇到 429 时最多重试几次（优先按 Retry-After 等待）
# SEMANTIC_SCHOLAR_MAX_RETRIES=3

# ==================== 创新点 2：方法论结构化抽取 + 对比表 ====================
# 抽取结果 SQLite 路径
RAG_EXTRACTION_PATH=data/extraction.db
# 入库后是否自动抽取方法画像（会额外消耗 LLM 调用；关掉可手动触发）
RAG_EXTRACTION_AUTO=true
RAG_EXTRACTION_MAX_RETRIES=2
# 每篇论文喂给抽取模型的最大字符数（控制成本）
RAG_EXTRACTION_MAX_CHARS=6000

# ==================== 多模态：图片理解 / PDF 图表 / 语音 ====================
# 总开关（关闭后前端不展示多模态入口，后端不调用视觉 / 语音接口）
RAG_MULTIMODAL_ENABLED=true
# 视觉模型名；留空则按模型名自动判断（gpt-4o / *-vl / gemini / claude-3 等）
# RAG_VISION_MODEL=gpt-4o
# 视觉模型可以单独配置 Key / 接口地址（文本用 DeepSeek、图片用 OpenAI 兼容视觉服务）
# RAG_VISION_API_KEY=sk-你的_vision_key
# RAG_VISION_BASE_URL=https://api.openai.com/v1
# 一次最多附带几张图片、单张大小上限（MB）
RAG_MULTIMODAL_MAX_IMAGES=3
RAG_MULTIMODAL_MAX_IMAGE_MB=8
# 是否保存原始 PDF，供「PDF 图表理解」按需提取图片
RAG_STORE_PDF=true
RAG_PAPERS_DIR=data/papers
# 图表过滤：小于该宽高 / 字节数的图片视为图标，忽略
RAG_FIGURE_MIN_WIDTH=160
RAG_FIGURE_MIN_HEIGHT=120
RAG_FIGURE_MIN_BYTES=4096
RAG_FIGURE_MAX_COUNT=8
# 语音转写：OpenAI Whisper 兼容接口（需要 OPENAI_API_KEY，或下面指定的变量）
RAG_ASR_MODEL=whisper-1
RAG_ASR_BASE_URL=https://api.openai.com/v1
RAG_ASR_API_KEY_ENV=OPENAI_API_KEY
RAG_ASR_TIMEOUT=90

# ==================== AI 安全与可控 ====================
# 总开关：提示注入拦截 + 内容过滤 + 输出脱敏
RAG_SAFETY_ENABLED=true
# 拦截「忽略以上指令 / 输出系统提示 / 越狱」这类提示注入
RAG_SAFETY_BLOCK_PROMPT_INJECTION=true
# 拦截明确的违法 / 暴力制作类操作性请求（保守词表，避免误伤学术讨论）
RAG_SAFETY_CONTENT_FILTER=true
# 对输出里的 API Key / Token / 私钥 / 邮箱做脱敏
RAG_SAFETY_REDACT_SECRETS=true
# 单条提问最大字符数（超长视为滥用）
RAG_SAFETY_MAX_QUESTION_CHARS=8000

# ==================== MCP（Model Context Protocol，可选） ====================
# 1) 作为 MCP Server：pip install "mcp>=1.0" 后运行 python -m scripts.mcp_server
# 2) 接入外部 MCP Server：pip install langchain-mcp-adapters，并配置下面的 JSON
#    格式与 langchain-mcp-adapters 的 MultiServerMCPClient 一致
# MCP_SERVERS={"filesystem":{"command":"npx","args":["-y","@modelcontextprotocol/server-filesystem","."],"transport":"stdio"}}
# 加载外部 MCP 工具的最长等待秒数；超时会自动降级为内置工具，避免拖慢登录初始化
MCP_LOAD_TIMEOUT=3
